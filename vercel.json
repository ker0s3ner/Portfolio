{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/doom",
      "destination": "/doom.html"
    },
    {
      "source": "/:path*/doom",
      "destination": "/doom.html"
    },
    {
      "source": "/:path*/doom/",
      "destination": "/doom.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
